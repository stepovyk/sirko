[Unit]
Description=SirkoAI – шаховий рушій Сірко на Lichess
After=network-online.target
Wants=network-online.target
# Без ключа Lichess боту нічого робити: його дає sudo sirko-bot token.
ConditionPathExists=/etc/sirko/token.env
StartLimitIntervalSec=0

[Service]
Type=simple
User=sirko
Group=sirko
# lichess-bot ставить і оновлює sirko-bot; служба його лише читає.
WorkingDirectory=/opt/sirko/lichess-bot
EnvironmentFile=/etc/sirko/token.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 COLUMNS=200
ExecStart=/opt/sirko/lichess-bot/venv/bin/python /opt/sirko/lichess-bot/lichess-bot.py --config /opt/sirko/config.yml --disable_auto_logging
Restart=always
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=15min

# Зупинка: Ctrl-C лише головному процесу, тоді бот дограє партію й виходить сам.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=150min

StateDirectory=sirko/games
StateDirectoryMode=0755

# Сервер – лише Сірка: рушій бере всі ядра; пам'яті – з запасом системі.
MemoryMax=85%

UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/opt:ro
BindReadOnlyPaths=/opt/sirko
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
